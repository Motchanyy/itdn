<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<%- include('../../partials/head'); %>
	</head>
	<body class="d-flex flex-column h-100">
		<%- include('../../partials/header'); %>
		<div class="container-fluid h-100">
			<div class="row h-100 align-items-center justify-content-center">
				<div class="col-12 col-md-4">
					<div class="card border-primary rounded-0">
						<div class="card-header text-bg-primary rounded-0">404</div>
						<div class="card-body">
							<% if (i18n.__('lang_iso') === 'en') { %>
							<p class="mb-0">Page not found!</p>
							<% } else { %>
							<p class="mb-0">Сторінка не знайдена!</p>
							<% } %>
						</div>
					</div>
				</div>
			</div>
		</div>
		<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
		<script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
		<script>
			const socket = io(); // Підключення до серверу socket.io
		</script>
	</body>
</html>
