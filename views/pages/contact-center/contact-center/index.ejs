<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('contact_center.chat.title') %></title>
		<%- include('../../../partials/head'); %>
		<style>
			.chats-list-card .avatar {
				height: 44px;
				width: 44px;
				position: relative;
				display: -webkit-box;
				display: -ms-flexbox;
				display: flex;
			}

			.chats-list-card h5 {
				font-size: 0.9375rem;
			}

			.chats-list-card .line-clamp {
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.chats-list-card .badge-circle {
				position: relative;
				border-radius: 2.25rem;
				height: calc(1em + 0.778em);
				padding: 0.389em;
			}

			.chats-list-card .badge-circle > span {
				display: block;
				min-width: 1em;
			}

			.chats-list-card a,
			.chats-archive-list-card a {
				position: relative;
				cursor: pointer;
				border-bottom: 1px solid #d2d2d2;
				display: block;
			}

			.chats-list-card a::after,
			.chats-archive-list-card a::after {
				position: absolute;
				content: "";
				height: 100%;
				width: 0.25rem;
				left: 0;
				top: 0;
			}

			.chats-list-card a:hover::after,
			.chats-archive-list-card a:hover::after {
				background-color: #0057b8;
			}

			form textarea {
				resize: none;
			}
		</style>
	</head>

	<body class="d-flex flex-column h-100">
		<%- include('../../../partials/header'); %>
		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('contact_center.chats_list.pagetitle') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('contact_center.chats_list.breadcrumb.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/orders"><%= i18n.__('contact_center.chats_list.breadcrumb.orders') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('contact_center.chats_list.breadcrumb.current') %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/orders" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
		<div class="container-fluid mt-3 h-100">
			<div class="row h-100">
				<div class="col-12 col-lg-3 mb-3 d-flex flex-column">
					<ul class="nav nav-underline nav-fill mb-3" id="pills-tab" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="pills-open-tab" data-bs-toggle="pill" data-bs-target="#pills-open" data-tab="open" type="button" role="tab" aria-controls="pills-open" aria-selected="true"><%= i18n.__('contact_center.chats_list.tab_open') %></button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="pills-resolved-tab" data-bs-toggle="pill" data-bs-target="#pills-resolved" data-tab="resolved" type="button" role="tab" aria-controls="pills-resolved" aria-selected="false"><%= i18n.__('contact_center.chats_list.tab_resolved') %></button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="pills-archived-tab" data-bs-toggle="pill" data-bs-target="#pills-archived" data-tab="archived" type="button" role="tab" aria-controls="pills-archived" aria-selected="false"><%= i18n.__('contact_center.chats_list.tab_archived') %></button>
						</li>
					</ul>
					<div class="tab-content h-100" id="pills-tabContent">
						<!-- ВКЛАДКА: ВІДКРИТІ -->
						<div class="tab-pane fade h-100 show active" id="pills-open" role="tabpanel" aria-labelledby="pills-open-tab" tabindex="0">
							<div class="h-100 d-flex flex-column">
								<form class="mb-3">
									<div class="input-group">
										<span class="input-group-text rounded-0"><i class="fa-solid fa-magnifying-glass"></i></span>
										<input type="text" class="form-control rounded-0 chat-search" data-target="chats-list-open" placeholder="<%= i18n.__('contact_center.chats_list.search') %>" />
									</div>
								</form>
								<div class="card h-100 rounded-0">
									<div class="card-header rounded-0"><%= i18n.__('contact_center.chats_list.card_chats') %></div>
									<div style="position: relative; height: 100%; overflow: hidden; min-height: 300px">
										<div id="chats-list-open" class="chats-list-card chats-container p-0 text-center" data-tab="open" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; width: 100%; scrollbar-width: thin; overflow-y: scroll; overflow-x: hidden"></div>
									</div>
								</div>
							</div>
						</div>

						<!-- ВКЛАДКА: ЗАВЕРШЕНІ -->
						<div class="tab-pane fade h-100" id="pills-resolved" role="tabpanel" aria-labelledby="pills-resolved-tab" tabindex="0">
							<div class="h-100 d-flex flex-column">
								<form class="mb-3">
									<div class="input-group">
										<span class="input-group-text rounded-0"><i class="fa-solid fa-magnifying-glass"></i></span>
										<input type="text" class="form-control rounded-0 chat-search" data-target="chats-list-resolved" placeholder="<%= i18n.__('contact_center.chats_list.search') %>" />
									</div>
								</form>
								<div class="card h-100 rounded-0">
									<div class="card-header rounded-0"><%= i18n.__('contact_center.chats_list.card_resolved') %></div>
									<div style="position: relative; height: 100%; overflow: hidden; min-height: 300px">
										<div id="chats-list-resolved" class="chats-list-card chats-container p-0 text-center" data-tab="resolved" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; width: 100%; scrollbar-width: thin; overflow-y: scroll; overflow-x: hidden"></div>
									</div>
								</div>
							</div>
						</div>

						<!-- ВКЛАДКА: АРХІВ -->
						<div class="tab-pane fade h-100" id="pills-archived" role="tabpanel" aria-labelledby="pills-archived-tab" tabindex="0">
							<div class="h-100 d-flex flex-column">
								<form class="mb-3">
									<div class="input-group">
										<span class="input-group-text rounded-0"><i class="fa-solid fa-magnifying-glass"></i></span>
										<input type="text" class="form-control rounded-0 chat-search" data-target="chats-list-archived" placeholder="<%= i18n.__('contact_center.chats_list.search') %>" />
									</div>
								</form>
								<div class="card h-100 rounded-0">
									<div class="card-header rounded-0"><%= i18n.__('contact_center.chats_list.card_archive') %></div>
									<div style="position: relative; height: 100%; overflow: hidden; min-height: 300px">
										<div id="chats-list-archived" class="chats-list-card chats-container p-0 text-center" data-tab="archived" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; width: 100%; scrollbar-width: thin; overflow-y: scroll; overflow-x: hidden"></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="col-12 col-lg-9 mb-3">
					<div class="card rounded-0">
						<div class="card-body">
							<p class="mb-0"><%= i18n.__('contact_center.chats_list.select_chat') %></p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<%- include('../../../partials/footer'); %> <%- include('../../../partials/script'); %>

		<script>
			// ================================================================
			// КОНСТАНТИ
			// ================================================================
			const currentUserId = "<%= user.id %>";
			const isUk = "<%= i18n.__('lang_iso') %>" === "uk";

			// Переклади для клієнтського коду (рендеряться на сервері)
			const T = {
				badgeArchive: "<%= i18n.__('contact_center.chats_list.badge_archive') %>",
				statusOpen: "<%= i18n.__('contact_center.chats_list.status_open') %>",
				statusInProgress: "<%= i18n.__('contact_center.chats_list.status_in_progress') %>",
				statusStripRegex: "<%= i18n.__('contact_center.chats_list.status_strip_regex') %>",
				emptyList: "<%= i18n.__('contact_center.chats_list.empty_list') %>",
				loadError: "<%= i18n.__('contact_center.chats_list.load_error') %>",
				loadErrorShort: "<%= i18n.__('contact_center.chats_list.load_error_short') %>",
				noMessages: "<%= i18n.__('contact_center.chats_list.no_messages') %>",
				timeJustNow: "<%= i18n.__('contact_center.chats_list.time_just_now') %>",
				webFallback: "<%= i18n.__('contact_center.chats_list.web_fallback') %>",
				botUnavailable: "<%= i18n.__('contact_center.chats_list.bot_unavailable') %>",
			};

			// ================================================================
			// ПОБУДОВА HTML елемента чату (канало-залежна) + іконка каналу
			// ================================================================
			// іконка каналу
			function channelIcon(channel) {
				if (channel === "webchat") return `<span class="ms-2" style="color:#16a34a;font-size:small;"><i class="fa-solid fa-globe"></i></span>`;
				if (channel === "instagram") return `<span class="ms-2" style="color:#e1306c;font-size:small;"><i class="fa-brands fa-instagram"></i></span>`;
				return `<span class="ms-2" style="color:#24a1de;font-size:small;"><i class="fa-brands fa-telegram"></i></span>`;
			}

			function buildChatInner(item) {
				const channel = item.channel || "telegram";

				// назва: telegram — ім'я; webchat — домен + короткий id відвідувача (або лід)
				let title;
				if (channel === "webchat") {
					title = item.title || "—";
				} else if (channel === "instagram") {
					title = item.title || [item.first_name, item.last_name].filter(Boolean).join(" ") || "—";
				} else {
					title = [item.first_name, item.last_name].filter(Boolean).join(" ") || "—";
				}

				const countBadge = item.count ? `<span class="badge text-bg-success ms-1">${item.count}</span>` : "";

				const archiveBadge = item.archive === "1" ? `<span class="badge text-bg-secondary ms-1">${T.badgeArchive}</span>` : "";

				// Бот недоступний (видалено/деактивовано) — лише для telegram
				const botBadge = channel === "telegram" && item.bot_available === 0 ? `<span class="badge text-bg-danger ms-1" title="${T.botUnavailable}"><i class="fa-solid fa-robot"></i> ${T.botUnavailable}</span>` : "";

				const statusMap = {
					0: `<span style="display:block;font-size:small;">🟢 ${T.statusOpen}</span>`,
					1: `<span style="display:block;font-size:small;">🔵 ${T.statusInProgress}</span>`,
				};
				const statusLabel = statusMap[item.status] ?? statusMap[0];

				return `<div class="d-flex align-items-center justify-content-between">
						<p class="mb-0">
							${title}
							${countBadge}
							${archiveBadge}
							${botBadge}
							${statusLabel}
						</p>
						${channelIcon(channel)}
					</div>`;
			}

			// ================================================================
			// UPSERT активного чату
			// Якщо елемент є — повністю оновлює вміст і переміщує вгору.
			// Якщо немає — створює новий елемент.
			// Це вирішує race condition між socket і AJAX.
			// ================================================================
			// посилання на діалог залежно від каналу
			function chatHref(item) {
				if ((item.channel || "telegram") === "webchat") return `/contact-center/webchat/${encodeURIComponent(item.url_token || "")}/`;
				if ((item.channel || "telegram") === "instagram") return `/contact-center/instagram/${item.chat_id}/`;
				return `/contact-center/telegram/${item.chat_id}/`;
			}

			// унікальний селектор: у веб-чату chat_id — рядок, тож шукаємо ще й по каналу
			function chatSelector(item) {
				const ch = item.channel || "telegram";
				return `a[data-channel="${ch}"][data-chat-id="${String(item.chat_id).replace(/"/g, "")}"]`;
			}

			const OPEN_LIST = "#chats-list-open";
			function spinnerHtml() {
				return '<svg width="24" height="24" viewBox="0 0 24 24" style="margin:15px auto;display:block"><rect x="1" y="4" width="6" height="14" style="fill:#0057b8;animation:spinner_Ctle .8s linear infinite;animation-delay:-.8s"></rect><rect x="9" y="4" width="6" height="14" style="fill:#0057b8;animation:spinner_Ctle .8s linear infinite;animation-delay:-.65s"></rect><rect x="17" y="4" width="6" height="14" style="fill:#0057b8;animation:spinner_Ctle .8s linear infinite;animation-delay:-.5s"></rect></svg>';
			}

			function upsertActiveChat(item, reorder = true, listSel = OPEN_LIST) {
				const $list = $(listSel);
				const channel = item.channel || "telegram";
				const $existing = $list.find(chatSelector(item));

				if ($existing.length) {
					// Якщо item не приніс bot_available (напр. socket-подія) — беремо збережений на елементі
					if (item.bot_available === undefined) {
						const prev = $existing.attr("data-bot-available");
						item.bot_available = prev === "0" ? 0 : 1;
					}
					$existing
						.data("status", item.status)
						.data("max-id", item.max_id ?? $existing.data("max-id"))
						.attr("data-status", item.status)
						.attr("data-max-id", item.max_id ?? $existing.attr("data-max-id"))
						.attr("data-bot-available", item.bot_available === 0 ? 0 : 1)
						.html(buildChatInner(item));
				} else {
					$list.find("svg, p.empty-msg").remove();
					$list.removeClass("text-center");

					const $newItem = $(`<a href="${chatHref(item)}"
								class="card-body d-block p-3 text-decoration-none text-reset"
								data-channel="${channel}"
								data-chat-id="${String(item.chat_id)}"
								data-site-id="${item.site_id || ""}"
								data-status="${item.status ?? 0}"
								data-max-id="${item.max_id ?? 0}"
								data-bot-available="${item.bot_available === 0 ? 0 : 1}"></a>`);
					$newItem.html(buildChatInner(item));
					if (reorder)
						$list.prepend($newItem); // нові/оновлені — зверху
					else $list.append($newItem); // початкове завантаження — по порядку
				}
			}

			// ================================================================
			// ВИДАЛЕННЯ активного чату
			// ================================================================
			// Прибрати чат з одного конкретного контейнера + показати empty, якщо спорожнів
			function removeFromList(listSel, chatId) {
				const $list = $(listSel);
				$list.find(`a[data-chat-id="${chatId}"]`).remove();
				if (!$list.find("a[data-chat-id]").length) {
					$list.find("svg, p.empty-msg").remove();
					$list.addClass("text-center").append(`<p class="empty-msg mt-3 mb-3">${T.emptyList}</p>`);
				}
			}

			// Прибрати чат з усіх вкладок
			function removeActiveChat(chatId) {
				removeFromList("#chats-list-open", chatId);
				removeFromList("#chats-list-resolved", chatId);
				removeFromList("#chats-list-archived", chatId);
			}
		</script>
		<script>
			// ================================================================
			// SOCKET — підписка на кімнати
			// ================================================================
			socket.emit("room", "io_alert_contact_center");
			socket.emit("room", `io_manager_${currentUserId}`);

			// Нове повідомлення від клієнта → у вкладку "Відкриті"
			socket.on("io_alert_contact_center", function (data) {
				upsertActiveChat(
					{
						channel: data.channel || "telegram",
						chat_id: data.chat_id,
						first_name: data.first_name,
						last_name: data.last_name,
						count: data.unique_chat_id_count,
						status: data.status ?? 0,
						archive: "0",
					},
					true,
					OPEN_LIST
				);
			});

			// Цьому менеджеру делегували чат
			socket.on("io_chat_delegated", function (data) {
				upsertActiveChat({
					chat_id: data.chat_id,
					first_name: data.first_name,
					last_name: data.last_name,
					count: data.count ?? 0,
					status: 1,
					archive: "0",
				});
			});

			// Чат передано іншому менеджеру — прибираємо
			socket.on("io_chat_removed", function (data) {
				removeActiveChat(data.chat_id);
			});

			// Чат заархівовано — прибрати з open/resolved; архів перезавантажити, якщо відкривали
			socket.on("io_chat_archived", function (data) {
				removeFromList("#chats-list-open", data.chat_id);
				removeFromList("#chats-list-resolved", data.chat_id);
				if (tabState.archived.loaded) loadTab("archived", true);
			});

			// Чат завершено — прибрати з open/archived; завершені перезавантажити, якщо відкривали
			socket.on("io_chat_resolved", function (data) {
				removeFromList("#chats-list-open", data.chat_id);
				removeFromList("#chats-list-archived", data.chat_id);
				if (tabState.resolved.loaded) loadTab("resolved", true);
			});

			let wcListView = "all"; // all | mine

			// Стан пагінації на кожну вкладку окремо
			const tabState = {
				open: { cursor: null, cursorCh: null, cursorId: null, loading: false, done: false, loaded: false, sel: "#chats-list-open" },
				resolved: { cursor: null, cursorCh: null, cursorId: null, loading: false, done: false, loaded: false, sel: "#chats-list-resolved" },
				archived: { cursor: null, cursorCh: null, cursorId: null, loading: false, done: false, loaded: false, sel: "#chats-list-archived" },
			};

			function buildAnyChatItem(it) {
				return {
					channel: it.channel,
					chat_id: it.chat_id,
					site_id: it.site_id || "",
					url_token: it.url_token || "",
					first_name: it.channel === "telegram" || it.channel === "instagram" ? it.title || "" : "",
					last_name: "",
					title: it.title,
					count: it.count || 0,
					status: it.status ?? 0,
					max_id: it.max_id ?? 0,
					archive: "0",
					bot_available: it.bot_available === 0 ? 0 : 1,
				};
			}

			function loadTab(tab, reset) {
				const st = tabState[tab];
				if (!st || st.loading) return;
				if (reset) {
					st.cursor = null;
					st.cursorCh = null;
					st.cursorId = null;
					st.done = false;
				}
				if (st.done) return;
				st.loading = true;

				const $list = $(st.sel);
				if (reset) $list.html(spinnerHtml());

				$.ajax({
					url: "/api/contact-center/get-list-chats/",
					method: "POST",
					contentType: "application/json",
					data: JSON.stringify({ view: wcListView, tab, cursor: st.cursor, cursorCh: st.cursorCh, cursorId: st.cursorId, limit: 30 }),
					success: function (resp) {
						const items = (resp && resp.items) || [];
						$list.find("svg").remove();
						$list.removeClass("text-center");

						items.forEach(function (it) {
							upsertActiveChat(buildAnyChatItem(it), false, st.sel);
							if (tab === "open" && it.channel === "webchat" && typeof window.wcApplyUnreadExternal === "function") {
								window.wcApplyUnreadExternal(it.chat_id, it.count || 0);
							}
						});

						if (!$list.find("a[data-chat-id]").length) {
							$list.find("svg, p.empty-msg").remove();
							$list.addClass("text-center").append(`<p class="empty-msg mt-3 mb-3">${T.emptyList}</p>`);
						} else {
							$list.find("p.empty-msg").remove();
						}

						st.cursor = resp.nextCursor || null;
						st.cursorCh = resp.nextCursorCh || null;
						st.cursorId = resp.nextCursorId || null;
						st.done = !st.cursor;
						st.loaded = true;
						st.loading = false;

						const _el = document.querySelector(st.sel);
						if (!st.done && _el && _el.scrollHeight <= _el.clientHeight + 40) loadTab(tab, false);
					},
					error: function (xhr) {
						st.loading = false;
						$list.find("svg").remove();
						if (!$list.find("a[data-chat-id]").length) {
							$list.addClass("text-center").html(`<p class="mt-3 text-danger">${T.loadError}</p>`);
						}
						console.error("get-list-chats:", xhr.status, xhr.statusText);
					},
				});
			}

			$(document).ready(function () {
				loadTab("open", true);

				$(".chats-container").each(function () {
					const tab = $(this).data("tab");
					this.addEventListener("scroll", function () {
						if (this.scrollTop + this.clientHeight >= this.scrollHeight - 120) loadTab(tab, false);
					});
				});

				$('#pills-tab button[data-bs-toggle="pill"]').on("shown.bs.tab", function () {
					const tab = $(this).data("tab");
					if (tabState[tab] && !tabState[tab].loaded) loadTab(tab, true);
				});
			});

			// ================================================================
			// ПОШУК — фільтрація по імені в обох списках
			// ================================================================
			$(document).ready(function () {
				$(".chat-search").on("input", function () {
					const query = $(this).val().toLowerCase().trim();
					const listId = $(this).data("target");
					$(`#${listId} a[data-chat-id]`).each(function () {
						const name = $(this).find("p").text().toLowerCase();
						$(this).toggle(name.includes(query));
					});
				});
			});
		</script>
		<script>
			// ================================================================
			// WEB-CHAT — окреме socket-з'єднання (namespace /webchat)
			// ================================================================
			(function initWebChat() {
				if (typeof io === "undefined") {
					setTimeout(initWebChat, 100);
					return;
				}

				const wsChat = io("/webchat", { transports: ["websocket", "polling"] });

				// мапінг веб-чат-чату у формат списку
				function webItem(c) {
					const visitor = String(c.roomId || "")
						.split("_")
						.slice(1)
						.join("_");
					const shortId = visitor ? visitor.replace(/^v_/, "").slice(0, 6) : "";
					const domain = c.domain || c.siteId || "";
					return {
						channel: "webchat",
						chat_id: c.roomId,
						site_id: c.siteId,
						url_token: c.urlToken || "",
						title: (domain ? domain : T.webFallback) + (shortId ? " · " + shortId : ""),
						count: c.unread || 0,
						status: 0,
						archive: "0",
						max_id: c.lastId || 0,
						empty: !!c.empty,
					};
				}

				wsChat.on("connect", function () {
					console.log("WC socket connected, userId =", currentUserId);
					wsChat.emit("operator:join", { userId: currentUserId });
				});
				wsChat.on("connect_error", function (e) {
					console.log("WC connect_error:", e.message);
				});
				wsChat.on("disconnect", function (r) {
					console.log("WC disconnect:", r);
				});
				wsChat.on("operator:sites", function (s) {
					console.log("WC operator:sites →", s);
				});

				// початковий список веб-чатів іде через HTTP (loadChatsPage).
				// Socket лише проставляє онлайн-статуси, елементи НЕ створює.
				wsChat.on("operator:active_chats", function (chats) {
					(chats || []).forEach(function (c) {
						if (c.empty) return;
						wcOnline[c.roomId] = !!c.online;
						wcApplyOnline(c.roomId);
					});
				});

				// новий відвідувач написав / повідомлення від клієнта
				// лічильник непрочитаних по веб-чатах (у цій вкладці)
				const wcUnread = {};
				const wcOnline = {}; // roomId → true/false

				function wcApplyUnread(roomId) {
					const $el = $(`a[data-channel="webchat"][data-chat-id="${String(roomId)}"]`);
					if (!$el.length) return;
					const n = wcUnread[roomId] | 0;
					$el.css("font-weight", n > 0 ? "bold" : "normal");
					let $b = $el.find(".wc-unread");
					if (n > 0) {
						if (!$b.length) {
							$b = $(`<span class="badge text-bg-danger ms-1 wc-unread"></span>`);
							$el.find("p").first().append($b);
						}
						$b.text(n > 99 ? "99+" : n);
					} else {
						$b.remove();
					}
				}

				window.wcApplyUnreadExternal = function (roomId, count) {
					wcUnread[roomId] = count | 0;
					wcApplyUnread(roomId);
				};

				function wcApplyOnline(roomId) {
					const $el = $(`a[data-channel="webchat"][data-chat-id="${String(roomId)}"]`);
					if (!$el.length) return;
					const on = !!wcOnline[roomId];
					let $dot = $el.find(".wc-dot");
					if (!$dot.length) {
						$dot = $(`<span class="wc-dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle"></span>`);
						$el.find("p").first().prepend($dot);
					}
					$dot.css("background", on ? "#22c55e" : "#c4c4c4");
				}

				// клік по веб-чату — скидаємо його лічильник непрочитаних
				$(document).on("click", 'a[data-channel="webchat"]', function () {
					const roomId = $(this).attr("data-chat-id");
					if (window.__wcUnreadReset) window.__wcUnreadReset(roomId);
				});

				window.__wcUnreadReset = function (roomId) {
					wcUnread[roomId] = 0;
					wcApplyUnread(roomId);
				};

				// хто онлайн зараз (приходить після operator:join)
				wsChat.on("operator:online_list", function (list) {
					if (!Array.isArray(list)) return;
					list.forEach(function (roomId) {
						wcOnline[roomId] = true;
						wcApplyOnline(roomId);
					});
				});
				// клієнт зайшов
				wsChat.on("operator:new_visitor", function (d) {
					if (!d || !d.roomId) return;
					wcOnline[d.roomId] = true;
					wcApplyOnline(d.roomId);
				});
				// клієнт пішов
				wsChat.on("operator:visitor_left", function (d) {
					if (!d || !d.roomId) return;
					wcOnline[d.roomId] = false;
					wcApplyOnline(d.roomId);
				});

				// початкові непрочитані з БД (персонально для цього менеджера)
				wsChat.on("operator:unread_counts", function (counts) {
					if (!counts || typeof counts !== "object") return;
					Object.keys(counts).forEach(function (roomId) {
						wcUnread[roomId] = counts[roomId] | 0;
						wcApplyUnread(roomId);
					});
				});

				wsChat.on("operator:unread_update", function (d) {
					if (!d || !d.roomId) return;
					wcUnread[d.roomId] = d.count | 0;
					wcApplyUnread(d.roomId);
				});

				// нотифікації чату прочитані (відкрили діалог) — прибрати зі списку сповіщень
				wsChat.on("operator:notif_read", function (d) {
					if (!d || !d.chatId) return;
					$(`#notification-chat-list li[data-notification-webchat="${d.chatId}"]`).remove();
					if (!$("#notification-chat-list li[data-notification-telegram], #notification-chat-list li[data-notification-webchat]").length) {
						$("#notification-chat-list").html(`<li><a class="d-flex align-items-center" href="#"><span class="me-2"><i class="fa-solid fa-info"></i></span><div>${T.noMessages}</div></a></li>`);
					}
					if (typeof favico !== "undefined") {
						favico_count = 0;
						favico.reset && favico.reset();
					}
				});

				// новий відвідувач написав / повідомлення від клієнта
				wsChat.on("operator:message", function (data) {
					console.log("WC operator:message →", data);
					if (!data || !data.message) return;
					if (data.message.from !== "client") return;
					const roomId = data.roomId;
					console.log("WC add to list, roomId =", roomId, "tabOpenLoaded =", tabState.open.loaded);
					// не рахуємо непрочитане, якщо цей чат зараз відкритий у сусідній вкладці — простіше рахувати завжди,
					// оператор скине лічильник, відкривши діалог
					wcUnread[roomId] = (wcUnread[roomId] | 0) + 1;

					// клієнт написав → чат знову "відкритий": прибрати з resolved/archived (з empty),
					// додати/оновити в open
					removeFromList("#chats-list-resolved", roomId);
					removeFromList("#chats-list-archived", roomId);

					if (tabState.open.loaded) {
						upsertActiveChat(
							webItem({
								roomId: roomId,
								siteId: data.siteId,
								domain: data.domain,
								urlToken: data.urlToken,
								lastId: data.message.id,
								unread: 0,
								empty: false,
							}),
							true,
							OPEN_LIST
						);
					} else {
						loadTab("open", true);
					}

					wcOnline[roomId] = true; // раз пише — точно онлайн
					wcApplyOnline(roomId);
					wcApplyUnread(roomId);

					// звук + favicon (ті самі, що для telegram, з script.ejs)
					// звук + favicon (ті самі, що для telegram, з script.ejs)
					try {
						if (typeof audio !== "undefined") audio.play();
					} catch (e) {}
					if (typeof favico !== "undefined") {
						favico_count = (favico_count | 0) + 1;
						favico.badge(favico_count);
					}
				});

				// оператор узяв / звільнив чат — оновлюємо статус
				wsChat.on("operator:conv_state", function (data) {
					if (!data) return;

					if (data.status === "archived") {
						removeFromList("#chats-list-open", data.roomId);
						removeFromList("#chats-list-resolved", data.roomId);
						if (tabState.archived.loaded) loadTab("archived", true);
						return;
					}
					if (data.status === "closed") {
						removeFromList("#chats-list-open", data.roomId);
						removeFromList("#chats-list-archived", data.roomId);
						if (tabState.resolved.loaded) loadTab("resolved", true);
						return;
					}
					if (data.status === "open") {
						removeFromList("#chats-list-resolved", data.roomId);
						removeFromList("#chats-list-archived", data.roomId);
					}

					const status = data.operatorId != null && Number(data.operatorId) === Number(currentUserId) ? 1 : 0;
					const $el = $(`#chats-list-open a[data-channel="webchat"][data-chat-id="${String(data.roomId)}"]`);
					if ($el.length) {
						$el.attr("data-status", status).data("status", status);
					}
				});

				// чат видалено
				wsChat.on("operator:chat_deleted", function (data) {
					if (!data) return;
					removeActiveChat(data.roomId);
				});

				window.__wsChat = wsChat; // доступ із діалогової сторінки потім
			})();
		</script>
	</body>
</html>
