	<script>
		$("#modal_delegate_chat").on("show.bs.modal", function () {
			$.ajax({
				url: "/api/contact-center/managers/list/",
				method: "POST", dataType: "json",
				success: function (data) {
					const select = $("#managers-list");
					select.empty();
					select.append('<option value="">-- <%= i18n.__("orders.columns.edit") %> --</option>');
					$.each(data, function (i, m) {
						select.append('<option value="' + m.id + '">' + m.name + "</option>");
					});
				},
				error: function () { console.log("managers list error"); },
			});
		});
	</script>

	<script>
		const CHAT_ID = "<%= data_telegram_chat_id %>";
		let mediaData = null;
		let currentMediaType = null;
		let lgInstance = null;

		function loadMedia() {
			if (mediaData) return Promise.resolve(mediaData);
			return $.ajax({ url: `/api/contact-center/telegram/${CHAT_ID}/media/`, method: "GET" })
				.then(data => { mediaData = data; return data; });
		}

		const renderers = {
			photos(items) {
				if (!items.length) return emptyHtml();
				const grid = items.map(item => `
					<a href="${item.url}" class="col-4 p-1 d-block"
						${item.caption ? `data-sub-html="<p>${item.caption}</p>"` : ''}>
						<img src="${item.url}" class="img-fluid w-100"
							style="height:100px;object-fit:cover;cursor:pointer;" alt="">
					</a>`).join('');
				return `<div id="lg-photos" class="row g-0">${grid}</div>`;
			},
			videos(items) {
				if (!items.length) return emptyHtml();
				const grid = items.map(item => `
					<a data-video='{"source":[{"src":"${item.url}","type":"video/mp4"}],"attributes":{"preload":false,"controls":true}}'
						data-poster="" data-lg-size="1280-720"
						class="col-4 p-1 d-block position-relative" style="cursor:pointer;">
						<video class="w-100" style="height:100px;object-fit:cover;pointer-events:none;">
							<source src="${item.url}" type="video/mp4">
						</video>
						<span class="position-absolute top-50 start-50 translate-middle"
							style="font-size:1.5rem;pointer-events:none;">▶</span>
					</a>`).join('');
				return `<div id="lg-videos" class="row g-0">${grid}</div>`;
			},
			files(items) {
				if (!items.length) return emptyHtml();
				return items.map(item => `
					<div class="d-flex align-items-center p-2 border-bottom">
						<img src="/assets/images/file-type/${item.ext}.svg"
							onerror="this.src='/assets/images/file-type/file.svg'"
							style="height:36px;width:36px;object-fit:contain;" class="me-2">
						<div class="flex-grow-1 overflow-hidden">
							<div class="text-truncate small fw-semibold">${item.name}</div>
							<div class="text-muted" style="font-size:11px;">${item.size || ''} &bull; ${item.date}</div>
						</div>
						<a href="${item.url}" download="${item.name}"
							class="btn btn-sm btn-outline-primary rounded-0 ms-2">
							<i class="fa-solid fa-download"></i>
						</a>
					</div>`).join('');
			},
			audio(items) {
				if (!items.length) return emptyHtml();
				return items.map(item => `
					<div class="p-2 border-bottom">
						<div class="small text-muted mb-1">${item.date}</div>
						<audio controls class="w-100" style="height:36px;"><source src="${item.url}"></audio>
					</div>`).join('');
			},
			voice(items) {
				if (!items.length) return emptyHtml();
				return items.map(item => `
					<div class="p-2 border-bottom">
						<div class="small text-muted mb-1">${item.date}</div>
						<audio controls class="w-100" style="height:36px;"><source src="${item.url}"></audio>
					</div>`).join('');
			},
			gifs(items) {
				if (!items.length) return emptyHtml();
				return `<div class="row g-1 p-2">` + items.map(item => `
					<div class="col-6">
						<img src="${item.url}" class="img-fluid w-100 rounded-0"
							style="max-height:150px;object-fit:cover;" alt="GIF">
						<div class="text-muted text-center" style="font-size:10px;">${item.date}</div>
					</div>`).join('') + `</div>`;
			},
			links(items) {
				if (!items.length) return emptyHtml();
				const seen = new Set();
				return items.filter(i => { if (seen.has(i.url)) return false; seen.add(i.url); return true; })
					.map(item => `
						<div class="p-2 border-bottom">
							<a href="${item.url}" target="_blank" rel="noopener noreferrer"
								class="text-break small">${item.url}</a>
							<div class="text-muted" style="font-size:10px;">${item.date}</div>
						</div>`).join('');
			},
		};

		function emptyHtml() {
			return '<div class="text-center text-muted p-4">Немає файлів</div>';
		}

		function showMediaType(type) {
			currentMediaType = type;
			const $content = $("#media-content");
			$content.html('<div class="text-center p-3"><div class="spinner-border spinner-border-sm"></div></div>');
			if (lgInstance) { lgInstance.destroy(); lgInstance = null; }
			loadMedia().then(data => {
				const items = data[type] || [];
				$content.html(renderers[type] ? renderers[type](items) : emptyHtml());
				if (type === 'photos') {
					const container = document.getElementById('lg-photos');
					if (container && items.length) {
						lgInstance = lightGallery(container, {
							plugins: [lgZoom, lgThumbnail, lgFullscreen],
							selector: 'a', speed: 400, thumbnail: true, animateThumb: true,
							showZoomInOutIcons: true, actualSize: false,
							mobileSettings: { controls: true, showCloseIcon: true, download: false },
						});
					}
				}
				if (type === 'videos') {
					const container = document.getElementById('lg-videos');
					if (container && items.length) {
						lgInstance = lightGallery(container, {
							plugins: [lgVideo, lgFullscreen],
							selector: 'a', speed: 400,
							video: { controls: true },
							mobileSettings: { controls: true, showCloseIcon: true },
						});
					}
				}
			}).catch(() => {
				$content.html('<div class="text-center text-danger p-3">Помилка завантаження</div>');
			});
		}

		$(document).ready(function () {
			$("#media-type-tabs").on("click", "button[data-media-type]", function () {
				$("#media-type-tabs button").removeClass("active");
				$(this).addClass("active");
				showMediaType($(this).data("media-type"));
			});
			$("#pills-media-tab").on("shown.bs.tab", function () {
				if (!currentMediaType) showMediaType("photos");
			});
		});
	</script>

</body>
</html>